# ─────────────────────────────────────────────────────────────
#  Lowfator Backend — Variables de entorno
#  Copia este fichero como .env y rellena los valores reales.
#  NUNCA subas el .env real a git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Servidor SMTP para el formulario de contacto
# Para Gmail: usa una "contraseña de aplicación" (App Password),
# no tu contraseña normal. Actívala en:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail

# Dirección a la que llegarán los mensajes del formulario
CONTACT_EMAIL_TO=tu_email_destino@ejemplo.com
